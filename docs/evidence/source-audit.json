      "observation": {
        "content": "[package]\nname = \"pikpaktui\"\nversion = \"0.0.63\"\nedition = \"2024\"\nrust-version = \"1.90\"\ndescription = \"A TUI and CLI client for PikPak cloud storage\"\nlicense = \"Apache-2.0\"\nrepository = \"https://github.com/Bengerthelorf/pikpaktui\"\nhomepage = \"https://app.snaix.homes/pikpaktui/\"\ndocumentation = \"https://app.snaix.homes/pikpaktui/\"\nkeywords = [\"tui\", \"pikpak\", \"cloud-storage\", \"cli\"]\ncategories = [\"command-line-utilities\"]\ninclude = [\n    \"/src/**/*.rs\",\n    \"/docs/configuration.md\",\n    \"/docs/zh/configuration.md\",\n    \"/docs/zh-Hant/configuration.md\",\n    \"/Cargo.toml\",\n    \"/Cargo.lock\",\n    \"/LICENSE\",\n    \"/README.md\",\n]\n\n[dependencies]\nanyhow = \"1\"\ncrossterm = \"0.29\"\nratatui = \"0.30.0\"\ndirs = \"6\"\nserde = { version = \"1\", features = [\"derive\"] }\nserde_json = \"1\"\nreqwest = { version = \"0.12\", default-features = false, features = [\"blocking\", \"json\", \"rustls-tls\"] }\ntoml = \"0.9.8\"\nsha1 = \"0.10\"\nsha2 = \"0.10\"\nmd-5 = \"0.10\"\nhmac = \"0.12\"\nbase64 = \"0.22\"\nunicode-width = \"0.2\"\nsyntect = { version = \"5.3.0\", default-features = false, features = [\"default-syntaxes\", \"default-themes\", \"regex-fancy\", \"plist-load\"] }\nimage = \"0.25\"\nratatui-image = { version = \"10.0\", default-features = false, features = [\"crossterm\"] }\nself_update = { version = \"0.43\", default-features = false, features = [\"archive-tar\", \"archive-zip\", \"compression-flate2\", \"compression-zip-deflate\", \"reqwest\", \"rustls\"] }\n\n[profile.release]\ncodegen-units = 1\nlto = true\nopt-level = \"s\"\nstrip = true\n"
      }
    },
