{
  "name": "nekopak",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run && node --test tests/api.test.mjs",
    "test:wire": "node --test tests/api.test.mjs",
    "e2e": "node tests/e2e/run.mjs",
    "size": "node scripts/ui-size-report.mjs",
    "tauri": "tauri",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:app-icons": "python scripts/android_project.py --generate-icons"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "preact": "10.27.2"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.48.1",
    "@material/material-color-utilities": "0.4.0",
    "@tauri-apps/cli": "2.12.4",
    "playwright": "1.56.1",
    "preact-render-to-string": "6.6.3",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
