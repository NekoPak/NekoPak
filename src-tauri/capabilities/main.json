{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local UI events and custom frame window controls only. No shell, arbitrary filesystem, remote URLs or credentials.",
  "windows": ["main"],
  "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close", "core:window:allow-is-maximized", "core:window:allow-start-dragging"]
}

