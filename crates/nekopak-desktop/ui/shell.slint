// Navigation sidebar and workspace tab strip.
import { ScrollView } from "std-widgets.slint";
import { Pal } from "generated/palette.slint";
import { Icons } from "generated/icons.slint";
import { Tk, Tr } from "tokens.slint";
import { Btn, IconBtn, Icon, FocusRing, Tip } from "widgets.slint";
import { Shell, NavEntry, TabEntry } from "state.slint";

component NavItem inherits Rectangle {
    in property <NavEntry> entry;
    in property <bool> rail;
    callback clicked();
    callback context(length, length);
    height: 46px;
    border-radius: 23px;
    background: entry.active ? Pal.secondary-container : ta.has-hover ? Tk.hover : transparent;
    accessible-role: list-item;
    accessible-label: entry.label;
    accessible-item-selected: entry.active;
    accessible-action-default => {
        root.clicked();
    }
    animate background { duration: Tk.t1; }
    FocusRing {
        active: fs.has-focus;
        radius: 23px;
    }

    HorizontalLayout {
        padding-left: root.rail ? 15px : 16px;
        padding-right: root.rail ? 0px : 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.entry.active ? root.entry.icon-active : root.entry.icon;
                tint: root.entry.active ? Pal.on-secondary-container : Pal.on-surface-variant;
                size: 22px;
            }
        }

        if !root.rail: Text {
            horizontal-stretch: 1;
            text: root.entry.label;
            color: root.entry.active ? Pal.on-secondary-container : Pal.on-surface;
            font-size: Tk.fs-md;
            font-weight: root.entry.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.rail && root.entry.badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                min-width: 20px;
                border-radius: 10px;
                background: Pal.primary;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.entry.badge;
                        color: Pal.on-primary;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Tip.hide();
            root.clicked();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                root.context(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
        changed has-hover => {
            if (self.has-hover && (root.rail || root.entry.tip != "")) {
                Tip.show(root.rail ? root.entry.label : root.entry.tip, root.absolute-position.x + root.width + 8px, root.absolute-position.y + 10px);
            } else {
                Tip.hide();
            }
        }
    }
}

component SectionLabel inherits Rectangle {
    in property <string> text;
    in property <bool> rail;
    height: rail ? 13px : 34px;
    if !root.rail: Text {
        x: 16px;
        y: 12px;
        text: root.text;
        color: Pal.on-surface-variant;
        font-size: Tk.fs-xs;
        font-weight: 600;
    }
    if root.rail: Rectangle {
        x: 22px;
        y: 6px;
        width: root.width - 44px;
        height: 1px;
        background: Pal.outline-variant;
    }
}

export component Sidebar inherits Rectangle {
    in property <bool> rail;
    width: rail ? Tk.rail-w : Tk.sidebar-w;
    accessible-role: none;
    animate width {
        duration: Tk.t2;
        easing: ease-out;
    }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 8px;
        spacing: 0px;
        // Brand head
        Rectangle {
            height: Tk.row-top;
            HorizontalLayout {
                padding-left: root.rail ? 0px : 6px;
                spacing: 10px;
                alignment: root.rail ? center : stretch;
                if !root.rail: VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../assets/app-icon.svg");
                        width: 28px;
                        height: 28px;
                    }
                }
                if !root.rail: Text {
                    text: "NekoPak";
                    color: Pal.on-surface;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if !root.rail && Shell.demo: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 22px;
                        border-radius: 6px;
                        background: demo-ta.has-hover ? Tk.hover : transparent;
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            Text {
                                text: Tr.t("演示");
                                color: Pal.on-surface-variant;
                                font-size: Tk.fs-xs;
                                vertical-alignment: center;
                            }
                        }

                        demo-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Shell.open-demo();
                            }
                        }
                    }
                }
                if !root.rail: Rectangle {
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconBtn {
                        icon: root.rail ? Icons.menu : Icons.menu-open;
                        tip: root.rail ? Tr.t("展开侧栏（Ctrl+B）") : Tr.t("收起侧栏（Ctrl+B）");
                        clicked => {
                            Shell.toggle-sidebar();
                        }
                    }
                }
            }
        }

        // Downloads entry with live activity
        dl := Rectangle {
            height: 52px;
            border-radius: Tk.r-lg;
            background: Shell.transfers-active ? Pal.primary-container : dl-ta.has-hover ? Tk.hover : transparent;
            accessible-role: button;
            accessible-label: Tr.t("下载") + (Shell.transfers-sub != "" ? "，" + Shell.transfers-sub : "");
            accessible-action-default => {
                Shell.open-transfers();
            }
            animate background { duration: Tk.t1; }
            FocusRing {
                active: dl-fs.has-focus;
                radius: Tk.r-lg;
            }

            HorizontalLayout {
                padding-left: root.rail ? 15px : 16px;
                padding-right: root.rail ? 0px : 12px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Shell.transfers-active ? Icons.download-fill : Icons.download;
                        tint: Shell.transfers-active ? Pal.on-primary-container : Pal.on-surface-variant;
                        size: 22px;
                    }
                }

                if !root.rail: VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: Tr.t("下载");
                        color: Shell.transfers-active ? Pal.on-primary-container : Pal.on-surface;
                        font-size: Tk.fs-md;
                        font-weight: 600;
                    }

                    if Shell.transfers-sub != "": Text {
                        text: Shell.transfers-sub;
                        color: Shell.transfers-alert && !Shell.transfers-active ? Pal.error : Shell.transfers-active ? Pal.on-primary-container : Pal.on-surface-variant;
                        font-size: Tk.fs-xs;
                        overflow: elide;
                    }
                }
                if !root.rail && Shell.transfers-count != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 22px;
                        min-width: 22px;
                        border-radius: 11px;
                        background: Pal.primary;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: Shell.transfers-count;
                                color: Pal.on-primary;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            if root.rail && Shell.transfers-count != "": Rectangle {
                x: dl.width - 26px;
                y: 6px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Shell.transfers-alert ? Pal.error : Pal.primary;
            }
            dl-fs := FocusScope {
                focus-on-click: false;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        Shell.open-transfers();
                        return accept;
                    }
                    return reject;
                }
            }

            dl-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Shell.open-transfers();
                }
                changed has-hover => {
                    if (self.has-hover) {
                        Tip.show(Tr.t("下载") + "（Ctrl+2）", dl.absolute-position.x + dl.width + 8px, dl.absolute-position.y + 12px);
                    } else {
                        Tip.hide();
                    }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            // The rail is too narrow for a scroll bar; the wheel still scrolls it.
            vertical-scrollbar-policy: root.rail ? ScrollBarPolicy.always-off : ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                SectionLabel {
                    text: Tr.t("快速访问");
                    rail: root.rail;
                }

                for entry in Shell.nav-quick: NavItem {
                    entry: entry;
                    rail: root.rail;
                    clicked => {
                        Shell.navigate(entry.id);
                    }
                    context(x, y) => {
                        Shell.nav-context(entry.id, x, y);
                    }
                }
                SectionLabel {
                    text: Tr.t("库");
                    rail: root.rail;
                }

                for entry in Shell.nav-library: NavItem {
                    entry: entry;
                    rail: root.rail;
                    clicked => {
                        Shell.navigate(entry.id);
                    }
                }
                SectionLabel {
                    text: Tr.t("工具");
                    rail: root.rail;
                }

                for entry in Shell.nav-tools: NavItem {
                    entry: entry;
                    rail: root.rail;
                    clicked => {
                        Shell.navigate(entry.id);
                    }
                }
            }
        }

        // The rail has no room beside the avatar, so settings sits above it.
        if root.rail: HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            IconBtn {
                icon: Shell.settings-active ? Icons.settings-fill : Icons.settings;
                active: Shell.settings-active;
                tip: Tr.t("设置（Ctrl+,）");
                clicked => {
                    Shell.open-settings();
                }
            }
        }
        // Account footer
        HorizontalLayout {
            spacing: 4px;
            padding-top: root.rail ? 2px : 6px;
            acct := Rectangle {
                horizontal-stretch: 1;
                height: 52px;
                border-radius: Tk.r-lg;
                background: Shell.account-active ? Pal.secondary-container : acct-ta.has-hover ? Tk.hover : transparent;
                accessible-role: button;
                accessible-label: Tr.t("账号与授权") + "：" + Shell.account-name;
                accessible-action-default => {
                    Shell.open-account();
                }
                FocusRing {
                    active: acct-fs.has-focus;
                    radius: Tk.r-lg;
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: root.rail ? 0px : 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: Pal.primary-container;
                            if Shell.account-initial != "": Text {
                                text: Shell.account-initial;
                                color: Pal.on-primary-container;
                                font-size: Tk.fs-md;
                                font-weight: 700;
                            }
                            if Shell.account-initial == "": Icon {
                                source: Icons.user;
                                tint: Pal.on-primary-container;
                            }
                        }
                    }

                    if !root.rail: VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: Shell.account-name;
                            color: Pal.on-surface;
                            font-size: Tk.fs-sm;
                            font-weight: 600;
                            overflow: elide;
                        }

                        Text {
                            text: Shell.account-sub;
                            color: Shell.account-warn ? Pal.error : Pal.on-surface-variant;
                            font-size: Tk.fs-xs;
                            overflow: elide;
                        }
                    }
                }

                acct-fs := FocusScope {
                    focus-on-click: false;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == " ") {
                            Shell.open-account();
                            return accept;
                        }
                        return reject;
                    }
                }

                acct-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Shell.open-account();
                    }
                }
            }

            if !root.rail: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Shell.settings-active ? Icons.settings-fill : Icons.settings;
                    active: Shell.settings-active;
                    tip: Tr.t("设置（Ctrl+,）");
                    clicked => {
                        Shell.open-settings();
                    }
                }
            }
        }
    }
}

component Tab inherits Rectangle {
    in property <TabEntry> entry;
    in property <bool> closable;
    callback activate();
    callback close();
    height: 36px;
    min-width: 64px;
    max-width: 220px;
    preferred-width: 180px;
    horizontal-stretch: 0;
    border-top-left-radius: Tk.r-md;
    border-top-right-radius: Tk.r-md;
    background: entry.active ? Tk.raised : ta.has-hover ? Tk.hover : transparent;
    accessible-role: tab;
    accessible-label: entry.title;
    accessible-item-selected: entry.active;
    accessible-action-default => {
        root.activate();
    }
    ta := TouchArea {
        clicked => {
            root.activate();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.middle && root.closable) {
                root.close();
            }
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 4px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.entry.title;
            color: root.entry.active ? Pal.on-surface : Pal.on-surface-variant;
            font-size: Tk.fs-sm;
            font-weight: root.entry.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.closable: VerticalLayout {
            alignment: center;
            IconBtn {
                height: 26px;
                icon: Icons.x;
                icon-size: 16px;
                tip: Tr.t("关闭标签页") + "（Ctrl+W）";
                clicked => {
                    root.close();
                }
            }
        }
    }
}

export component TabStrip inherits Rectangle {
    height: 40px;
    HorizontalLayout {
        padding-top: 4px;
        spacing: 2px;
        alignment: start;
        for entry in Shell.tabs: Tab {
            entry: entry;
            closable: Shell.tabs.length > 1;
            activate => {
                Shell.tab-activate(entry.id);
            }
            close => {
                Shell.tab-close(entry.id);
            }
        }
        VerticalLayout {
            alignment: center;
            IconBtn {
                height: 30px;
                icon: Icons.plus;
                tip: Tr.t("新建标签页") + "（Ctrl+T）";
                clicked => {
                    Shell.tab-new();
                }
            }
        }
    }
}
