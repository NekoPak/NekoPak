// Window-level layers: menus, modal dialogs, toasts and the shared tooltip.
import { ListView, ScrollView } from "std-widgets.slint";
import { Pal } from "generated/palette.slint";
import { Icons } from "generated/icons.slint";
import { Tk, Tr } from "tokens.slint";
import { Btn, IconBtn, Icon, Field, Check, Busy, KindIcon, Tip, FocusRing } from "widgets.slint";
import { Menu, MenuEntry, Dialogs, DialogSpec, Toasts, ToastEntry, FileRow, FormField } from "state.slint";

component MenuRow inherits Rectangle {
    in property <MenuEntry> entry;
    in property <bool> current;
    callback activated();
    callback hovered();
    height: entry.separator ? 9px : 36px;
    if root.entry.separator: Rectangle {
        y: 4px;
        height: 1px;
        background: Pal.outline-variant.with-alpha(0.7);
    }
    if !root.entry.separator: Rectangle {
        x: 4px;
        width: root.width - 8px;
        border-radius: Tk.r-sm;
        background: !root.entry.enabled ? transparent : ta.pressed ? Tk.press : root.current || ta.has-hover ? Tk.hover : transparent;
        opacity: root.entry.enabled ? 1 : 0.45;
        accessible-role: list-item;
        accessible-label: root.entry.label;
        accessible-enabled: root.entry.enabled;
        accessible-action-default => {
            root.activated();
        }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 12px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    if root.entry.checked: Icon {
                        source: Icons.check;
                        tint: Pal.primary;
                    }
                    if !root.entry.checked && root.entry.icon.width > 0: Icon {
                        source: root.entry.icon;
                        tint: root.entry.danger ? Pal.error : Pal.on-surface-variant;
                    }
                }
            }

            Text {
                horizontal-stretch: 1;
                text: root.entry.label;
                color: root.entry.danger ? Pal.error : Pal.on-surface;
                font-size: Tk.fs-md;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.entry.hint != "": Text {
                text: root.entry.hint;
                color: Pal.on-surface-variant;
                font-size: Tk.fs-xs;
                vertical-alignment: center;
            }
        }

        ta := TouchArea {
            enabled: root.entry.enabled;
            clicked => {
                root.activated();
            }
            changed has-hover => {
                if (self.has-hover) {
                    root.hovered();
                }
            }
        }
    }
}

export component MenuLayer inherits Rectangle {
    // Swallows the click that dismisses the menu so it cannot hit the page.
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                Menu.dismissed();
            }
        }
    }

    panel := Rectangle {
        property <length> wanted-w: Math.min(Math.max(220px, body.preferred-width), 360px);
        property <length> wanted-h: Math.min(body.preferred-height, root.height - 16px);
        x: Math.max(8px, Math.min(Menu.x, root.width - self.width - 8px));
        y: Math.max(8px, Menu.y + self.height > root.height - 8px ? Math.max(8px, Menu.y - self.height - 4px) : Menu.y);
        width: wanted-w;
        height: wanted-h;
        border-radius: Tk.r-md;
        background: Pal.surface-high;
        border-width: 1px;
        border-color: Pal.outline-variant.with-alpha(0.5);
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 6px;
        drop-shadow-color: Tk.shadow;
        accessible-role: AccessibleRole.list;
        accessible-label: Menu.title;
        TouchArea { }

        ScrollView {
            content-height: body.preferred-height;
            content-width: panel.width;
            body := VerticalLayout {
                width: panel.width;
                padding-top: 6px;
                padding-bottom: 6px;
                if Menu.title != "": Rectangle {
                    height: 30px;
                    Text {
                        x: 16px;
                        width: parent.width - 32px;
                        text: Menu.title;
                        color: Pal.on-surface-variant;
                        font-size: Tk.fs-xs;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                for entry[index] in Menu.items: MenuRow {
                    entry: entry;
                    current: index == Menu.current;
                    activated => {
                        Menu.activated(entry.id);
                    }
                }
            }
        }
    }

    fs := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                Menu.dismissed();
            } else if (event.text == Key.DownArrow || event.text == Key.Tab) {
                Menu.move(1);
            } else if (event.text == Key.UpArrow) {
                Menu.move(-1);
            } else if (event.text == Key.Home) {
                Menu.move(-1000);
            } else if (event.text == Key.End) {
                Menu.move(1000);
            } else if (event.text == Key.Return || event.text == " ") {
                Menu.activate-current();
            }
            return accept;
        }
    }

    init => {
        fs.focus();
    }
}

component PickerRow inherits Rectangle {
    in property <FileRow> item;
    callback activated();
    height: 44px;
    border-radius: Tk.r-sm;
    background: ta.pressed ? Tk.press : ta.has-hover ? Tk.hover : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            KindIcon {
                kind: root.item.kind;
                size: 30px;
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.item.name;
            color: Pal.on-surface;
            font-size: Tk.fs-md;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                source: Icons.chevron-right;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

component DialogCard inherits Rectangle {
    in property <DialogSpec> spec;
    in property <bool> top;
    property <length> card-w: Math.min(spec.width > 0 ? spec.width : spec.kind == "picker" ? 560px : spec.kind == "details" ? 560px : 440px, root.width - 48px);
    property <string> typed: spec.value;
    function submit() {
        if (root.spec.confirm-enabled && !root.spec.busy) {
            Dialogs.action(root.spec.id, "confirm", root.spec.kind == "prompt" ? root.typed : "");
        }
    }
    function dismiss() {
        if (root.spec.dismissable && !root.spec.busy) {
            Dialogs.action(root.spec.id, "cancel", "");
        }
    }
    background: Tk.scrim;
    TouchArea {
        clicked => {
            root.dismiss();
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            if (event.text == Key.Return && root.spec.kind != "prompt" && root.spec.kind != "form") {
                root.submit();
                return accept;
            }
            return reject;
        }

        card := Rectangle {
            x: (root.width - self.width) / 2;
            y: Math.max(24px, (root.height - self.height) / 2);
            width: root.card-w;
            height: Math.min(content.preferred-height, root.height - 48px);
            border-radius: Tk.r-xl;
            background: Pal.surface-high;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Tk.shadow;
            accessible-role: none;
            TouchArea { }

            content := VerticalLayout {
                padding: 24px;
                padding-bottom: 20px;
                spacing: 14px;
                Text {
                    text: root.spec.title;
                    color: Pal.on-surface;
                    font-size: Tk.fs-xl;
                    font-weight: 600;
                    wrap: word-wrap;
                    accessible-role: text;
                }

                if root.spec.body != "": Text {
                    text: root.spec.body;
                    color: Pal.on-surface-variant;
                    font-size: Tk.fs-md;
                    wrap: word-wrap;
                }
                if root.spec.kind == "prompt": VerticalLayout {
                    spacing: 6px;
                    if root.spec.label != "": Text {
                        text: root.spec.label;
                        color: Pal.on-surface-variant;
                        font-size: Tk.fs-sm;
                    }
                    input := Field {
                        text: root.spec.value;
                        placeholder: root.spec.placeholder;
                        label: root.spec.label != "" ? root.spec.label : root.spec.title;
                        password: root.spec.password;
                        invalid: root.spec.error != "";
                        enabled: !root.spec.busy;
                        edited(text) => {
                            root.typed = text;
                            Dialogs.edited(root.spec.id, text);
                        }
                        accepted(text) => {
                            root.typed = text;
                            root.submit();
                        }
                        escape => {
                            root.dismiss();
                        }
                        init => {
                            self.focus-input();
                            if (root.spec.select-to > 0) {
                                self.select-range(0, root.spec.select-to);
                            } else {
                                self.select-all();
                            }
                        }
                    }

                    Text {
                        text: root.spec.error != "" ? root.spec.error : root.spec.hint;
                        color: root.spec.error != "" ? Pal.error : Pal.on-surface-variant;
                        font-size: Tk.fs-xs;
                        wrap: word-wrap;
                        min-height: 16px;
                    }
                }
                if root.spec.kind == "form": VerticalLayout {
                    spacing: 12px;
                    for field in root.spec.fields: VerticalLayout {
                        spacing: 6px;
                        if field.kind == "note": HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: start;
                                Icon {
                                    source: field.tone == "error" ? Icons.alert-circle : field.tone == "warn" ? Icons.alert : field.tone == "ok" ? Icons.check-circle : Icons.info;
                                    tint: field.tone == "error" ? Pal.error : field.tone == "warn" ? Pal.warn : field.tone == "ok" ? Pal.ok : Pal.on-surface-variant;
                                    size: 18px;
                                }
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: field.label;
                                color: field.tone == "error" ? Pal.error : Pal.on-surface-variant;
                                font-size: Tk.fs-sm;
                                wrap: word-wrap;
                            }
                        }
                        if (field.kind == "text" || field.kind == "password" || field.kind == "multiline" || field.kind == "select") && field.label != "": Text {
                            text: field.label;
                            color: Pal.on-surface-variant;
                            font-size: Tk.fs-sm;
                        }
                        if field.kind == "text" || field.kind == "password": Field {
                            text: field.value;
                            placeholder: field.placeholder;
                            label: field.label;
                            password: field.kind == "password";
                            invalid: field.error != "";
                            enabled: field.enabled && !root.spec.busy;
                            edited(text) => {
                                Dialogs.field-edited(root.spec.id, field.id, text);
                            }
                            accepted(text) => {
                                Dialogs.field-edited(root.spec.id, field.id, text);
                                root.submit();
                            }
                            escape => {
                                root.dismiss();
                            }
                            init => {
                                if (field.tone == "focus") {
                                    self.focus-input();
                                }
                            }
                        }
                        if field.kind == "multiline": Rectangle {
                            height: 112px;
                            border-radius: Tk.r-sm;
                            border-width: area.has-focus || field.error != "" ? 2px : 1px;
                            border-color: field.error != "" ? Pal.error : area.has-focus ? Pal.primary : Pal.outline-variant;
                            background: Tk.raised;
                            clip: true;
                            if area.text == "": Text {
                                x: 12px;
                                y: 10px;
                                width: parent.width - 24px;
                                text: field.placeholder;
                                color: Pal.on-surface-variant.with-alpha(0.72);
                                font-size: Tk.fs-md;
                                wrap: word-wrap;
                            }
                            area := TextInput {
                                x: 12px;
                                y: 10px;
                                width: parent.width - 24px;
                                height: parent.height - 20px;
                                text: field.value;
                                font-size: Tk.fs-md;
                                color: Pal.on-surface;
                                single-line: false;
                                wrap: word-wrap;
                                enabled: field.enabled && !root.spec.busy;
                                selection-background-color: Pal.primary.with-alpha(0.35);
                                selection-foreground-color: Pal.on-surface;
                                accessible-label: field.label;
                                edited => {
                                    Dialogs.field-edited(root.spec.id, field.id, self.text);
                                }
                                key-pressed(event) => {
                                    if (event.text == Key.Escape) {
                                        root.dismiss();
                                        return accept;
                                    }
                                    if (event.text == Key.Return && event.modifiers.control) {
                                        root.submit();
                                        return accept;
                                    }
                                    return reject;
                                }
                                init => {
                                    if (field.tone == "focus") {
                                        self.focus();
                                    }
                                }
                            }
                        }
                        if field.kind == "select": Rectangle {
                            height: 40px;
                            border-radius: Tk.r-sm;
                            border-width: 1px;
                            border-color: Pal.outline-variant;
                            background: sel-ta.has-hover ? Tk.hover : Tk.raised;
                            opacity: field.enabled ? 1 : 0.5;
                            accessible-role: button;
                            accessible-label: field.label + "：" + field.value;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: field.value;
                                    color: Pal.on-surface;
                                    font-size: Tk.fs-md;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: Icons.chevron-down;
                                    }
                                }
                            }

                            sel-ta := TouchArea {
                                enabled: field.enabled && !root.spec.busy;
                                mouse-cursor: pointer;
                                clicked => {
                                    Dialogs.field-action(root.spec.id, field.id, self.absolute-position.x, self.absolute-position.y + self.height + 4px);
                                }
                            }
                        }
                        if field.kind == "toggle": HorizontalLayout {
                            spacing: 4px;
                            Check {
                                state: field.checked ? 1 : 0;
                                label: field.label;
                                enabled: field.enabled && !root.spec.busy;
                                toggled => {
                                    Dialogs.field-toggled(root.spec.id, field.id, !field.checked);
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: field.label;
                                    color: Pal.on-surface;
                                    font-size: Tk.fs-md;
                                    wrap: word-wrap;
                                }

                                if field.detail != "": Text {
                                    text: field.detail;
                                    color: Pal.on-surface-variant;
                                    font-size: Tk.fs-xs;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if field.kind != "toggle" && field.kind != "note" && (field.error != "" || field.detail != ""): Text {
                            text: field.error != "" ? field.error : field.detail;
                            color: field.error != "" ? Pal.error : Pal.on-surface-variant;
                            font-size: Tk.fs-xs;
                            wrap: word-wrap;
                        }
                    }
                    if root.spec.error != "": Text {
                        text: root.spec.error;
                        color: Pal.error;
                        font-size: Tk.fs-sm;
                        wrap: word-wrap;
                    }
                }
                if root.spec.kind == "details": Rectangle {
                    height: Math.min(details.preferred-height, 380px);
                    ScrollView {
                        content-height: details.preferred-height;
                        content-width: parent.width;
                        details := VerticalLayout {
                            width: parent.width;
                            spacing: 2px;
                            for item in root.spec.details: HorizontalLayout {
                                spacing: 16px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Text {
                                    width: 112px;
                                    text: item.key;
                                    color: Pal.on-surface-variant;
                                    font-size: Tk.fs-sm;
                                    wrap: word-wrap;
                                }

                                TextInput {
                                    horizontal-stretch: 1;
                                    text: item.value;
                                    color: Pal.on-surface;
                                    font-size: Tk.fs-sm;
                                    font-family: item.mono ? "Cascadia Mono, Consolas, monospace" : "";
                                    read-only: true;
                                    wrap: word-wrap;
                                    single-line: false;
                                    selection-background-color: Pal.primary.with-alpha(0.35);
                                    selection-foreground-color: Pal.on-surface;
                                }
                            }
                        }
                    }
                }
                if root.spec.kind == "choice": VerticalLayout {
                    spacing: 2px;
                    for item in root.spec.choices: Rectangle {
                        height: item.detail != "" ? 52px : 40px;
                        border-radius: Tk.r-sm;
                        background: item.selected ? Tk.selected : choice-ta.has-hover ? Tk.hover : transparent;
                        opacity: item.enabled ? 1 : 0.45;
                        accessible-role: list-item;
                        accessible-label: item.label;
                        accessible-item-selected: item.selected;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: item.selected ? Icons.check-circle-fill : Icons.checkbox-off;
                                    tint: item.selected ? Pal.primary : Pal.on-surface-variant;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: item.label;
                                    color: Pal.on-surface;
                                    font-size: Tk.fs-md;
                                    overflow: elide;
                                }

                                if item.detail != "": Text {
                                    text: item.detail;
                                    color: Pal.on-surface-variant;
                                    font-size: Tk.fs-xs;
                                    overflow: elide;
                                }
                            }
                        }

                        choice-ta := TouchArea {
                            enabled: item.enabled && !root.spec.busy;
                            mouse-cursor: pointer;
                            clicked => {
                                Dialogs.choice(root.spec.id, item.id);
                            }
                        }
                    }
                }
                if root.spec.kind == "picker": VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 36px;
                        border-radius: 18px;
                        background: Tk.raised;
                        clip: true;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 12px;
                            spacing: 0px;
                            alignment: start;
                            for crumb[index] in root.spec.crumbs: HorizontalLayout {
                                spacing: 0px;
                                if index > 0: VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: Icons.chevron-right;
                                        size: 16px;
                                    }
                                }
                                Rectangle {
                                    border-radius: 14px;
                                    background: crumb-ta.has-hover && index < root.spec.crumbs.length - 1 ? Tk.hover : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: crumb.name;
                                            color: index == root.spec.crumbs.length - 1 ? Pal.on-surface : Pal.on-surface-variant;
                                            font-size: Tk.fs-sm;
                                            font-weight: index == root.spec.crumbs.length - 1 ? 600 : 400;
                                            vertical-alignment: center;
                                        }
                                    }

                                    crumb-ta := TouchArea {
                                        enabled: index < root.spec.crumbs.length - 1;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            Dialogs.crumb(root.spec.id, crumb.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 300px;
                        border-radius: Tk.r-md;
                        background: Tk.raised;
                        if root.spec.phase == "loading": Busy { }
                        if root.spec.phase == "error": Text {
                            width: parent.width - 32px;
                            text: root.spec.error;
                            color: Pal.error;
                            font-size: Tk.fs-md;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        if root.spec.phase == "ready" && root.spec.rows.length == 0: Text {
                            text: Tr.t("没有子文件夹");
                            color: Pal.on-surface-variant;
                            font-size: Tk.fs-md;
                        }
                        if root.spec.phase == "ready" && root.spec.rows.length > 0: ListView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            for row[index] in root.spec.rows: PickerRow {
                                item: row;
                                activated => {
                                    Dialogs.row-activated(root.spec.id, index);
                                }
                            }
                        }
                    }

                    if root.spec.hint != "": Text {
                        text: root.spec.hint;
                        color: Pal.on-surface-variant;
                        font-size: Tk.fs-xs;
                        wrap: word-wrap;
                    }
                }
                if root.spec.option != "": HorizontalLayout {
                    spacing: 4px;
                    Check {
                        state: root.spec.option-checked ? 1 : 0;
                        label: root.spec.option;
                        enabled: !root.spec.busy;
                        toggled => {
                            Dialogs.option-toggled(root.spec.id, !root.spec.option-checked);
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.spec.option;
                        color: Pal.on-surface;
                        font-size: Tk.fs-md;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    padding-top: 4px;
                    if root.spec.alt != "": Btn {
                        text: root.spec.alt;
                        kind: "outline";
                        enabled: !root.spec.busy;
                        clicked => {
                            Dialogs.action(root.spec.id, "alt", "");
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.spec.busy: Busy {
                            x: parent.width - 28px;
                            size: 22px;
                        }
                    }

                    if root.spec.cancel != "": Btn {
                        text: root.spec.cancel;
                        enabled: !root.spec.busy;
                        clicked => {
                            Dialogs.action(root.spec.id, "cancel", "");
                        }
                    }
                    if root.spec.confirm != "": Btn {
                        text: root.spec.confirm;
                        kind: root.spec.danger ? "danger" : "filled";
                        enabled: root.spec.confirm-enabled && !root.spec.busy;
                        clicked => {
                            root.submit();
                        }
                    }
                }
            }
        }
    }

    init => {
        if (root.spec.kind != "prompt" && root.spec.kind != "form") {
            keys.focus();
        }
    }
}

export component DialogLayer inherits Rectangle {
    for spec[index] in Dialogs.stack: DialogCard {
        spec: spec;
        top: index == Dialogs.stack.length - 1;
    }
}

component Toast inherits Rectangle {
    in property <ToastEntry> entry;
    property <color> fg: Pal.inverse-on-surface;
    height: Math.max(48px, row.preferred-height);
    width: Math.min(row.preferred-width, 560px);
    border-radius: Tk.r-md;
    background: Pal.inverse-surface;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Tk.shadow;
    accessible-role: text;
    accessible-label: entry.text;
    TouchArea { }

    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.entry.tone == "error" ? Icons.alert-circle : root.entry.tone == "warning" ? Icons.alert : root.entry.tone == "success" ? Icons.check-circle : Icons.info;
                tint: root.entry.tone == "error" ? Pal.error-container : root.entry.tone == "warning" ? Pal.warn-container : root.entry.tone == "success" ? Pal.ok-container : root.fg;
            }
        }

        Text {
            max-width: 400px;
            text: root.entry.text;
            color: root.fg;
            font-size: Tk.fs-md;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        if root.entry.action != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 32px;
                border-radius: 16px;
                background: act.has-hover ? Pal.inverse-primary.with-alpha(0.16) : transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.entry.action;
                        color: Pal.inverse-primary;
                        font-size: Tk.fs-md;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                act := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Toasts.action(root.entry.id);
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: close.has-hover ? Pal.inverse-on-surface.with-alpha(0.12) : transparent;
                Icon {
                    source: Icons.x;
                    tint: root.fg;
                    size: 18px;
                }

                close := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Toasts.dismiss(root.entry.id);
                    }
                }
            }
        }
    }
}

export component ToastLayer inherits Rectangle {
    VerticalLayout {
        alignment: end;
        padding-bottom: 20px;
        spacing: 8px;
        for entry in Toasts.items: HorizontalLayout {
            alignment: center;
            Toast {
                entry: entry;
            }
        }
    }
}

export component TipLayer inherits Rectangle {
    Timer {
        interval: 550ms;
        running: Tip.wanted && !Tip.visible;
        triggered => {
            Tip.visible = true;
        }
    }

    if Tip.visible && Tip.text != "": Rectangle {
        x: Math.max(6px, Math.min(Tip.x - self.width / 2, root.width - self.width - 6px));
        y: Tip.y + self.height > root.height - 6px ? Tip.y - self.height - 48px : Tip.y;
        width: tip-text.preferred-width + 16px;
        height: 28px;
        border-radius: 6px;
        background: Pal.inverse-surface;
        tip-text := Text {
            text: Tip.text;
            color: Pal.inverse-on-surface;
            font-size: Tk.fs-xs;
        }
    }
}
