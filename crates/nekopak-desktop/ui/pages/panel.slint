// Generic panel page: a titled, sectioned list rendered from Rust data.
// Settings, account, sync, mount, shares and the tool pages all use it so
// they share one look, one keyboard model and one accessibility tree.
import { ListView } from "std-widgets.slint";
import { Pal } from "../generated/palette.slint";
import { Icons } from "../generated/icons.slint";
import { Tk, Tr } from "../tokens.slint";
import { Btn, IconBtn, Icon, Toggle, Busy, Meter, KindIcon, EmptyState, Chip } from "../widgets.slint";
import { Panel, PanelRow } from "../state.slint";

component Row inherits Rectangle {
    in property <PanelRow> item;
    callback act(string, length, length);
    property <bool> clickable: item.enabled && (item.kind == "select" || item.kind == "item" || item.kind == "toggle" || (item.kind == "button" && item.action == ""));
    property <length> pad: 16px;
    height: item.kind == "header" ? 44px
        : item.kind == "note" ? Math.max(40px, note.preferred-height + 16px)
        : item.detail != "" || item.kind == "progress" ? 66px : 52px;
    if root.item.kind == "header": Text {
        x: 4px;
        y: 18px;
        text: root.item.title;
        color: Pal.primary;
        font-size: Tk.fs-sm;
        font-weight: 600;
    }
    note := HorizontalLayout {
        visible: root.item.kind == "note";
        x: 0px;
        width: root.width;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        if root.item.kind == "note": VerticalLayout {
            alignment: center;
            Icon {
                source: root.item.tone == "error" ? Icons.alert-circle : root.item.tone == "warn" ? Icons.alert : root.item.tone == "ok" ? Icons.check-circle : Icons.info;
                tint: root.item.tone == "error" ? Pal.error : root.item.tone == "warn" ? Pal.warn : root.item.tone == "ok" ? Pal.ok : Pal.on-surface-variant;
                size: 18px;
            }
        }
        if root.item.kind == "note": Text {
            horizontal-stretch: 1;
            text: root.item.title;
            color: root.item.tone == "error" ? Pal.error : Pal.on-surface-variant;
            font-size: Tk.fs-sm;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }

    if root.item.kind != "header" && root.item.kind != "note": Rectangle {
        border-radius: Tk.r-md;
        background: root.item.selected ? Tk.selected : root.clickable && ta.pressed ? Tk.press : root.clickable && ta.has-hover ? Tk.hover : transparent;
        opacity: root.item.enabled ? 1 : 0.5;
        accessible-role: list-item;
        accessible-label: root.item.title + (root.item.value != "" ? "：" + root.item.value : "");
        accessible-description: root.item.detail;
        accessible-checked: root.item.checked;
        accessible-checkable: root.item.kind == "toggle";
        accessible-action-default => {
            root.act(root.item.kind == "toggle" ? "toggle" : "click", root.absolute-position.x + 40px, root.absolute-position.y + root.height);
        }
        ta := TouchArea {
            enabled: root.clickable;
            mouse-cursor: root.clickable ? pointer : default;
            clicked => {
                root.act(root.item.kind == "toggle" ? "toggle" : "click", root.absolute-position.x + root.width - 280px, root.absolute-position.y + root.height - 6px);
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right && root.item.menu) {
                    root.act("menu", root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
                }
            }
        }

        fs := FocusScope {
            enabled: root.clickable;
            focus-on-click: false;
            key-pressed(event) => {
                if (event.text == Key.Return || event.text == " ") {
                    root.act(root.item.kind == "toggle" ? "toggle" : "click", root.absolute-position.x + 40px, root.absolute-position.y + root.height);
                    return accept;
                }
                return reject;
            }
        }

        Rectangle {
            border-radius: Tk.r-md;
            border-width: fs.has-focus ? 2px : 0px;
            border-color: Pal.primary;
        }

        body := HorizontalLayout {
            padding-left: 12px;
            padding-right: 14px;
            spacing: 14px;
            if root.item.file-kind >= 0: VerticalLayout {
                alignment: center;
                KindIcon {
                    kind: root.item.file-kind;
                    size: 34px;
                }
            }
            if root.item.file-kind < 0 && root.item.icon.width > 0: VerticalLayout {
                alignment: center;
                Icon {
                    source: root.item.icon;
                    size: 22px;
                    tint: root.item.tone == "error" ? Pal.error : root.item.tone == "warn" ? Pal.warn : root.item.tone == "ok" ? Pal.ok : root.item.tone == "primary" ? Pal.primary : Pal.on-surface-variant;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text {
                    text: root.item.title;
                    color: root.item.danger ? Pal.error : Pal.on-surface;
                    font-size: Tk.fs-md;
                    font-weight: root.item.kind == "item" ? 500 : 400;
                    overflow: elide;
                }

                if root.item.detail != "": Text {
                    text: root.item.detail;
                    color: root.item.tone == "error" && root.item.kind != "item" ? Pal.error : Pal.on-surface-variant;
                    font-size: Tk.fs-sm;
                    overflow: elide;
                }
                if root.item.kind == "progress": Meter {
                    value: root.item.progress;
                    tone: root.item.tone == "error" ? "error" : root.item.tone == "ok" ? "ok" : "primary";
                }
            }

            if root.item.kind == "segment": VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 40px;
                    border-radius: 20px;
                    background: Pal.surface-high;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        for option in root.item.options: Chip {
                            height: 36px;
                            text: option.label;
                            selected: option.selected;
                            clicked => {
                                root.act(option.id, 0px, 0px);
                            }
                        }
                    }
                }
            }
            if root.item.value != "" && root.item.kind != "segment": Text {
                max-width: root.width * 0.45;
                text: root.item.value;
                color: root.item.kind == "select" ? Pal.primary : Pal.on-surface-variant;
                font-size: Tk.fs-sm;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
            if root.item.kind == "select": VerticalLayout {
                alignment: center;
                Icon {
                    source: Icons.chevron-down;
                    size: 18px;
                }
            }
            if root.item.kind == "toggle": VerticalLayout {
                alignment: center;
                padding-right: 2px;
                Toggle {
                    checked: root.item.checked;
                    enabled: root.item.enabled;
                    label: root.item.title;
                    toggled(value) => {
                        root.act("toggle", 0px, 0px);
                    }
                }
            }
            if root.item.action2 != "": VerticalLayout {
                alignment: center;
                Btn {
                    text: root.item.action2;
                    kind: "quiet";
                    enabled: root.item.enabled;
                    clicked => {
                        root.act("action2", self.abs-x, self.abs-y + self.height + 4px);
                    }
                }
            }
            if root.item.action != "": VerticalLayout {
                alignment: center;
                Btn {
                    text: root.item.action;
                    kind: root.item.danger ? "danger-quiet" : root.item.kind == "button" ? "tonal" : "outline";
                    enabled: root.item.enabled;
                    clicked => {
                        root.act("action", self.abs-x, self.abs-y + self.height + 4px);
                    }
                }
            }
            if root.item.menu: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.more;
                    tip: Tr.t("更多操作");
                    clicked => {
                        root.act("menu", self.abs-x - 180px, self.abs-y + self.height + 4px);
                    }
                }
            }
        }
    }
}

export component PanelPage inherits Rectangle {
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: Tk.row-top;
            padding-right: 8px;
            spacing: 8px;
            if Panel.can-back: VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.arrow-back;
                    tip: Tr.t("后退（Alt+←）");
                    clicked => {
                        Panel.back();
                    }
                }
            }
            if Panel.icon.width > 0: VerticalLayout {
                alignment: center;
                padding-left: Panel.can-back ? 0px : 8px;
                Icon {
                    source: Panel.icon;
                    size: 24px;
                    tint: Pal.on-surface;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: Panel.title;
                    color: Pal.on-surface;
                    font-size: Tk.fs-xl;
                    font-weight: 600;
                    overflow: elide;
                }

                if Panel.subtitle != "": Text {
                    text: Panel.subtitle;
                    color: Pal.on-surface-variant;
                    font-size: Tk.fs-sm;
                    overflow: elide;
                }
            }

            for action in Panel.actions: VerticalLayout {
                alignment: center;
                Btn {
                    text: action.label;
                    icon: action.icon;
                    enabled: action.enabled;
                    kind: action.checked ? "filled" : action.danger ? "danger-quiet" : "quiet";
                    tip: action.enabled ? action.hint : action.reason;
                    clicked => {
                        Panel.action(action.id, self.abs-x, self.abs-y + self.height + 4px);
                    }
                }
            }
        }

        if Panel.tabs.length > 0: HorizontalLayout {
            height: Tk.row-cmd;
            alignment: start;
            spacing: 4px;
            for tab in Panel.tabs: VerticalLayout {
                alignment: center;
                Chip {
                    text: tab.label;
                    count: tab.detail;
                    selected: tab.selected;
                    clicked => {
                        Panel.tab(tab.id);
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            border-radius: Tk.r-lg;
            background: Tk.raised;
            clip: true;
            if Panel.phase == "loading": Busy {
                size: 32px;
            }
            if Panel.phase == "error" || Panel.phase == "empty": EmptyState {
                icon: Panel.state-icon;
                title: Panel.state-title;
                body: Panel.state-body;
                action: Panel.state-action;
                error: Panel.state-error;
                action-clicked => {
                    Panel.state-action-clicked();
                }
            }
            if Panel.phase == "ready": ListView {
                x: 12px;
                y: 4px;
                width: parent.width - 16px;
                height: parent.height - 8px;
                for item in Panel.rows: Row {
                    item: item;
                    act(what, x, y) => {
                        Panel.row(item.id, what, x, y);
                    }
                }
            }
        }
    }
}
