// Media library: the pictures or videos of one folder as a thumbnail wall.
// Rows are virtualised; thumbnails load for the visible rows only.
import { ListView } from "std-widgets.slint";
import { Pal } from "../generated/palette.slint";
import { Icons } from "../generated/icons.slint";
import { Tk, Tr } from "../tokens.slint";
import { Btn, IconBtn, Icon, Busy, KindIcon, EmptyState, Chip } from "../widgets.slint";
import { Gallery, GalleryTile } from "../state.slint";

component Tile inherits Rectangle {
    in property <GalleryTile> tile;
    in property <length> side;
    callback activated();
    callback context(length, length);
    width: side;
    height: side + 34px;
    accessible-role: button;
    accessible-label: tile.name;
    accessible-action-default => {
        root.activated();
    }
    frame := Rectangle {
        width: root.side;
        height: root.side;
        y: 0px;
        border-radius: Tk.r-md;
        clip: true;
        background: Pal.surface-container;
        if root.tile.loaded: Image {
            width: parent.width;
            height: parent.height;
            source: root.tile.thumb;
            image-fit: cover;
        }
        if !root.tile.loaded: KindIcon {
            kind: root.tile.kind;
            size: 56px;
            background: transparent;
        }
        if root.tile.kind == 1: Rectangle {
            x: 8px;
            y: parent.height - self.height - 8px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: #000000a0;
            Icon {
                source: Icons.play-fill;
                tint: #ffffff;
                size: 16px;
            }
        }
        // Hover veil and focus outline sit above the picture.
        Rectangle {
            border-radius: Tk.r-md;
            background: ta.pressed ? #00000033 : ta.has-hover ? #0000001a : transparent;
            border-width: ta.has-hover ? 2px : 0px;
            border-color: Pal.primary;
            animate background { duration: Tk.t1; }
        }
    }

    Text {
        x: 4px;
        y: root.side + 6px;
        width: root.side - 8px;
        text: root.tile.name;
        color: Pal.on-surface;
        font-size: Tk.fs-sm;
        horizontal-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                root.context(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component GalleryPage inherits Rectangle {
    property <length> side: 172px;
    property <length> gap: 10px;
    property <int> wanted-columns: Math.max(1, Math.floor((island.width - 24px + gap) / (side + gap)));
    changed wanted-columns => {
        Gallery.columns-changed(wanted-columns);
    }
    init => {
        Gallery.columns-changed(wanted-columns);
    }
    VerticalLayout {
        spacing: 0px;
        HorizontalLayout {
            height: Tk.row-top;
            padding-right: 8px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.arrow-back;
                    tip: Tr.t("返回文件列表");
                    clicked => {
                        Gallery.back();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    source: Icons.library;
                    size: 24px;
                    tint: Pal.on-surface;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: Tr.t("媒体库");
                    color: Pal.on-surface;
                    font-size: Tk.fs-xl;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: Gallery.title;
                    color: Pal.on-surface-variant;
                    font-size: Tk.fs-sm;
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            height: Tk.row-cmd;
            padding-right: 8px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                Chip {
                    text: Tr.t("图库");
                    count: Gallery.images-count;
                    selected: Gallery.mode == "images";
                    clicked => {
                        Gallery.set-mode("images");
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Chip {
                    text: Tr.t("视频");
                    count: Gallery.videos-count;
                    selected: Gallery.mode == "videos";
                    clicked => {
                        Gallery.set-mode("videos");
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: Gallery.count-label;
                color: Pal.on-surface-variant;
                font-size: Tk.fs-sm;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                IconBtn {
                    icon: Icons.refresh;
                    tip: Tr.t("刷新（F5）");
                    clicked => {
                        Gallery.refresh();
                    }
                }
            }
        }

        island := Rectangle {
            vertical-stretch: 1;
            border-radius: Tk.r-lg;
            background: Tk.raised;
            clip: true;
            if Gallery.phase == "loading": Busy {
                size: 32px;
            }
            if Gallery.phase == "error" || Gallery.phase == "empty": EmptyState {
                icon: Gallery.state-error ? Icons.alert-circle : Gallery.mode == "videos" ? Icons.video : Icons.image;
                title: Gallery.state-title;
                body: Gallery.state-body;
                error: Gallery.state-error;
                action: Gallery.state-error ? Tr.t("重试") : "";
                action-clicked => {
                    Gallery.retry();
                }
            }
            if Gallery.phase == "ready": VerticalLayout {
                padding: 12px;
                padding-right: 4px;
                wall := ListView {
                    content-y <=> Gallery.viewport-y;
                    accessible-role: AccessibleRole.list;
                    accessible-label: Tr.t("媒体库");
                    for line in Gallery.rows: HorizontalLayout {
                        height: root.side + 34px + root.gap;
                        alignment: start;
                        spacing: root.gap;
                        padding-bottom: root.gap;
                        for tile[offset] in line.tiles: Tile {
                            tile: tile;
                            side: root.side;
                            activated => {
                                Gallery.open(line.first + offset);
                            }
                            context(x, y) => {
                                Gallery.context(line.first + offset, x, y);
                            }
                        }
                    }
                    changed content-y => {
                        Gallery.scrolled();
                        if (Gallery.has-more && !Gallery.loading-more && -self.content-y + self.visible-height > self.content-height - 600px) {
                            Gallery.near-end();
                        }
                    }
                    changed visible-height => {
                        Gallery.visible-height = self.visible-height;
                        Gallery.scrolled();
                    }
                    init => {
                        Gallery.visible-height = self.visible-height;
                        Gallery.scrolled();
                    }
                }
            }
            if Gallery.phase == "ready" && Gallery.loading-more: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 12px;
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: Pal.inverse-surface;
                Busy {
                    size: 20px;
                    tint: Pal.inverse-primary;
                }
            }
        }
    }
}
